NEXT_PUBLIC_SITE_URL=http://localhost:3000
CMS_API_URL=
CMS_API_KEY=
# Shared secret the CMS sends to POST /api/revalidate when content is saved.
# At least 32 characters, same value as this site's entry in the CMS's
# SITE_REVALIDATE_TARGETS. Without it CMS content refreshes hourly instead.
CMS_REVALIDATE_SECRET=
